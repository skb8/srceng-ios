+bool CEngineAPI::RunFrame()
+{
+	if ( !m_bIOSSimulationLoaded || eng->GetQuitting() != IEngine::QUIT_NOTQUITTING )
+		return false;
+
+	PumpMessages();
+	if ( eng->GetQuitting() != IEngine::QUIT_NOTQUITTING )
+		return false;
+
+	VCRSyncToken( "Frame" );
+	Engine_RunFrameWithoutWait();
+	return eng->GetQuitting() == IEngine::QUIT_NOTQUITTING;
