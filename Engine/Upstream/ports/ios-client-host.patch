+{
+	if ( !m_bIOSStartupReady )
+		return;
+
+	if ( m_pIOSModGroup )
+	{
+		if ( m_bIOSSimulationLoaded )
+		{
+			m_bIOSSimulationLoaded = false;
+			eng->Unload();
+			toolframework->ServerShutdown();
+			SV_ShutdownGameDLL();
+		}
+
+		m_pIOSModGroup->Shutdown();
+		delete m_pIOSModGroup;
+		m_pIOSModGroup = NULL;
+		g_AppSystemFactory = m_pIOSParentFactory;
+		ModShutdown();
+		videomode->SetGameWindow( NULL );
+	}
+
+	OnShutdown();
+}
